ARCH ?= $(if $(CRAFT_ARCH_BUILD_FOR),$(CRAFT_ARCH_BUILD_FOR),$(shell dpkg --print-architecture))
BUILD_DIR ?= $(if $(CRAFT_PART_BUILD),$(CRAFT_PART_BUILD),$(CURDIR)/.build)/compute-runtime
DESTDIR ?= $(CRAFT_PART_INSTALL)

# Paste the relevant release-note wget URLs here, without the wget prefix.
define LEGACY_URLS
https://github.com/intel/intel-graphics-compiler/releases/download/igc-1.0.17537.24/intel-igc-core_1.0.17537.24_amd64.deb
https://github.com/intel/intel-graphics-compiler/releases/download/igc-1.0.17537.24/intel-igc-opencl_1.0.17537.24_amd64.deb
https://github.com/intel/compute-runtime/releases/download/24.35.30872.36/intel-level-zero-gpu-legacy1_1.5.30872.36_amd64.deb
endef

define LATEST_URLS
https://github.com/intel/intel-graphics-compiler/releases/download/v2.36.3/intel-igc-core-2_2.36.3+21719_amd64.deb
https://github.com/intel/intel-graphics-compiler/releases/download/v2.36.3/intel-igc-opencl-2_2.36.3+21719_amd64.deb
https://github.com/intel/compute-runtime/releases/download/26.22.38646.4/intel-ocloc_26.22.38646.4-0_amd64.deb
https://github.com/intel/compute-runtime/releases/download/26.22.38646.4/libze-intel-gpu1_26.22.38646.4-0_amd64.deb
endef

LEGACY_DEBS := $(addprefix $(BUILD_DIR)/opencl-intel-legacy1/,$(notdir $(LEGACY_URLS)))
LATEST_DEBS := $(addprefix $(BUILD_DIR)/opencl-intel/,$(notdir $(LATEST_URLS)))

.PHONY: all download install
all: download

ifeq ($(ARCH),amd64)
download: $(LEGACY_DEBS) $(LATEST_DEBS)

define download_deb
	mkdir -p "$(@D)"
	wget -nv -O "$@.tmp" "$(filter %/$(@F),$(1))"
	mv "$@.tmp" "$@"
endef

$(LEGACY_DEBS):
	$(call download_deb,$(LEGACY_URLS))

$(LATEST_DEBS):
	$(call download_deb,$(LATEST_URLS))

install: download
	@test -n "$(DESTDIR)" || { echo "DESTDIR or CRAFT_PART_INSTALL must be set" >&2; exit 1; }
	mkdir -p "$(abspath $(DESTDIR))"
	dpkg --root="$(abspath $(DESTDIR))" --force-all -i $(foreach deb,$(LEGACY_DEBS),"$(deb)")
	dpkg --root="$(abspath $(DESTDIR))" --force-all -i $(foreach deb,$(LATEST_DEBS),"$(deb)")
else
download install:
	@echo "Skipping Intel compute runtime packages for $(ARCH) (amd64 only)"
endif
